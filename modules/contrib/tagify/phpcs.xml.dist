<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="tagify">
  <description>Drupal + DrupalPractice standards for Tagify and its submodules.</description>

  <!-- Scan the whole project: module root + modules/* submodules. -->
  <file>.</file>

  <!-- Non-source directories pulled in by Composer/Yarn or the Tagify lib. -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/libraries/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>

  <!-- PHP/YAML sources. JS/CSS are handled by ESLint + Stylelint, not PHPCS. -->
  <arg name="extensions" value="php,module,inc,install,test,profile,theme,info,yml"/>

  <!-- Show sniff codes (s) and progress (p); use colours. -->
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
