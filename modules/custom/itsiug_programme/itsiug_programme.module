<?php

/**
 * @file
 * Conference programme behaviour.
 */

declare(strict_types=1);

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function itsiug_programme_preprocess_views_view(array &$variables): void {
  if ($variables['view']->id() === 'programme') {
    $variables['#attached']['library'][] = 'itsiug_programme/programme';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_table.
 *
 * Adds the column heading to each cell so narrow screens can stack the table
 * into labelled cards.
 */
function itsiug_programme_preprocess_views_view_table(array &$variables): void {
  if ($variables['view']->id() !== 'programme') {
    return;
  }

  $renderer = \Drupal::service('renderer');
  $labels = [];
  foreach ($variables['header'] as $key => $column) {
    $content = $column['content'] ?? '';
    if (is_array($content)) {
      $content = $renderer->renderInIsolation($content);
    }
    $labels[$key] = trim(strip_tags((string) $content));
  }
  $variables['header'] = [];

  $time_slots = [];
  $slot_rooms = [];
  foreach ($variables['rows'] as $row_index => $row) {
    $time = itsiug_programme_render_view_field($variables['view'], $row_index, 'field_session_times', $renderer);
    $room = itsiug_programme_render_view_field($variables['view'], $row_index, 'field_room', $renderer);
    $room_key = trim(strip_tags($room));
    $time_key = trim(strip_tags($time));
    if ($time_key !== '' && !isset($time_slots[$time_key])) {
      $time_slots[$time_key] = count($time_slots) + 1;
    }
    if ($time_key !== '' && $room_key !== '' && !isset($slot_rooms[$time_key][$room_key])) {
      $slot_rooms[$time_key][$room_key] = count($slot_rooms[$time_key] ?? []) + 1;
    }
  }

  foreach ($variables['rows'] as $row_index => $row) {
    $time = itsiug_programme_render_view_field($variables['view'], $row_index, 'field_session_times', $renderer);
    $room = itsiug_programme_render_view_field($variables['view'], $row_index, 'field_room', $renderer);
    $time_key = trim(strip_tags($time));
    $room_key = trim(strip_tags($room));
    $row_attributes = $variables['rows'][$row_index]['attributes'] ?? NULL;
    if ($row_attributes && isset($time_slots[$time_key], $slot_rooms[$time_key][$room_key])) {
      $variables['rows'][$row_index]['attributes']['class'][] = 'itsiug-programme-card-row';
      $variables['rows'][$row_index]['attributes']['style'] = sprintf('--programme-row: %d; --programme-column: %d;', $time_slots[$time_key], $slot_rooms[$time_key][$room_key]);
    }

    $card = '<div class="programme-card__time">' . $time . '</div>';
    $card .= '<div class="programme-card__room">' . $room . '</div>';
    $card .= '<div class="programme-card__session">' . itsiug_programme_render_view_field($variables['view'], $row_index, 'field_session_number', $renderer) . '</div>';
    $card .= '<h4 class="programme-card__title">' . itsiug_programme_render_view_field($variables['view'], $row_index, 'title', $renderer) . '</h4>';
    $card .= '<div class="programme-card__category">' . itsiug_programme_render_view_field($variables['view'], $row_index, 'field_category', $renderer) . '</div>';
    $card .= itsiug_programme_synopsis_markup($variables['view'], $row_index);
    $card .= '<div class="programme-card__speakers">' . itsiug_programme_render_view_field($variables['view'], $row_index, 'nothing', $renderer) . '</div>';
    $card .= itsiug_programme_presentation_markup($variables['view'], $row_index);

    if (isset($variables['rows'][$row_index]['columns']['nothing'])) {
      $variables['rows'][$row_index]['columns']['nothing']['content'] = [
        ['separator' => '', 'field_output' => ['#markup' => \Drupal\Core\Render\Markup::create($card)]],
      ];
      $variables['rows'][$row_index]['columns']['nothing']['attributes']['class'][] = 'programme-card-cell';
    }

    foreach ($row['columns'] as $key => $column) {
      if (empty($column['attributes'])) {
        continue;
      }
      if (!empty($labels[$key])) {
        $variables['rows'][$row_index]['columns'][$key]['attributes']['data-label'] = $labels[$key];
      }
      // Views leaves whitespace in empty cells, so :empty cannot be used.
      $value = (string) $variables['view']->style_plugin->getField($row_index, $key);
      if (trim(strip_tags($value)) === '') {
        $variables['rows'][$row_index]['columns'][$key]['attributes']['class'][] = 'itsiug-cell-empty';
      }
    }
  }

  $variables['attributes']['class'][] = 'programme-card-grid';
  $slot_counts = array_values(array_map('count', $slot_rooms));
  $variables['attributes']['style'] = '--programme-columns: ' . max(1, ...$slot_counts) . ';';
}

/**
 * Builds the "Download Presentation" pill link for a card.
 */
function itsiug_programme_presentation_markup($view, int $row_index): string {
  $node = $view->result[$row_index]->_entity ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface || !$node->hasField('field_presentation')) {
    return '';
  }

  $links = [];
  foreach ($node->get('field_presentation')->referencedEntities() as $document) {
    if (!$document->access('view')) {
      continue;
    }
    foreach ($document->getFields() as $field) {
      if ($field->getFieldDefinition()->getType() !== 'file') {
        continue;
      }
      foreach ($field as $item) {
        $file = $item->entity;
        if (!$file) {
          continue;
        }
        $url = $file->createFileUrl();
        $size = \Drupal\Core\StringTranslation\ByteSizeMarkup::create((int) $file->getSize());
        $links[] = '<a class="programme-download-button" href="' . htmlspecialchars($url, ENT_QUOTES, 'UTF-8') . '" download>'
          . t('Download Presentation') . '</a>'
          . '<span class="programme-download-size">' . htmlspecialchars((string) $size, ENT_QUOTES, 'UTF-8') . '</span>';
      }
    }
  }

  if (!$links) {
    return '';
  }

  return '<div class="programme-card__presentation">' . implode('', $links) . '</div>';
}

/**
 * Builds the "Synopsis" button and its hidden modal content for a card.
 */
function itsiug_programme_synopsis_markup($view, int $row_index): string {
  $node = $view->result[$row_index]->_entity ?? NULL;
  if (!$node instanceof \Drupal\node\NodeInterface || !$node->hasField('field_description')) {
    return '';
  }
  $synopsis = trim((string) $node->get('field_description')->value);
  if ($synopsis === '') {
    return '';
  }

  $title = $node->label();
  return '<div class="programme-card__synopsis">'
    . '<button type="button" class="programme-synopsis-button" data-programme-synopsis-open>' . t('Synopsis') . '</button>'
    . '<div class="programme-synopsis-source" hidden>'
    . '<span class="programme-synopsis-source__title">' . htmlspecialchars($title, ENT_QUOTES, 'UTF-8') . '</span>'
    . '<span class="programme-synopsis-source__body">' . nl2br(htmlspecialchars($synopsis, ENT_QUOTES, 'UTF-8')) . '</span>'
    . '</div>'
    . '</div>';
}

/**
 * Renders a Views field for reuse inside the programme card.
 */
function itsiug_programme_render_view_field($view, int $row_index, string $field, object $renderer): string {
  $value = $view->style_plugin->getField($row_index, $field);
  if (is_array($value)) {
    $value = $renderer->renderInIsolation($value);
  }
  return (string) $value;
}
