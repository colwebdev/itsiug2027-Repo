<?php

use Drupal\node\Entity\Node;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Session\AccountInterface;
use Drupal\node\NodeInterface;
use Drupal\Component\Utility\Html;

/**
 * Implements hook_webform_submission_insert().
 */
function itsiug_registration_webform_submission_insert(
  WebformSubmissionInterface $webform_submission
) {

  // Only process the Delegate Registration Webform.
  if ($webform_submission->getWebform()->id() !== 'delegate_registration') {
    return;
  }

  // ------------------------------------------------------------
  // Get the institution from the authenticated registration session.
  // ------------------------------------------------------------

  $session = \Drupal::request()->getSession();
  $registration_context = $session->get('itsiug_registration');

  if (empty($registration_context['institution_nid'])) {
    \Drupal::logger('itsiug_registration')->error(
      'Delegate registration submitted without an institution session.'
    );
    return;
  }

  $institution_nid = $registration_context['institution_nid'];

  $institution = Node::load($institution_nid);

  if (!$institution) {
    \Drupal::logger('itsiug_registration')->error(
      'Institution @nid could not be loaded.',
      [
        '@nid' => $institution_nid,
      ]
    );
    return;
  }

  // ------------------------------------------------------------
  // Get Webform submission data.
  // ------------------------------------------------------------

  $data = $webform_submission->getData();

  // ------------------------------------------------------------
  // Convert Webform values to taxonomy term IDs.
  // ------------------------------------------------------------

  $country_tid = itsiug_find_taxonomy_term(
    $data['country'] ?? NULL,
    'countries'
  );

  $track_tid = itsiug_find_taxonomy_term(
    $data['track_preference'] ?? NULL,
    'conference_tracks'
  );

  $dietary_tid = itsiug_find_taxonomy_term(
    $data['dietary_requirements'] ?? NULL,
    'dietry_requirements'
  );

  // ------------------------------------------------------------
  // Create Delegate.
  // ------------------------------------------------------------

  $title_value = itsiug_map_list_field_value(
    $data['title'] ?? NULL,
    [
      'prof' => 'Prof',
      'dr' => 'Dr',
      'mr' => 'Mr',
      'mrs' => 'Mrs',
      'miss' => 'Miss',
      'ms' => 'Ms',
    ]
  );

  $delegate = Node::create([
    'type' => 'delegate',

    'title' => trim(
      ($data['first_name'] ?? '') . ' ' .
      ($data['last_name'] ?? '')
    ),

    'status' => 1,

    'field_title' => $title_value,
    'field_first_name' => $data['first_name'] ?? '',
    'field_last_name' => $data['last_name'] ?? '',
    'field_email' => $data['email'] ?? '',
    'field_mobile' => $data['mobile'] ?? '',
    'field_job_title' => trim((string) ($data['job_title'] ?? '')),

    // Institution comes from the PIN session.
    'field_institution' => [
      'target_id' => $institution->id(),
    ],

    // Taxonomy references.
    'field_country' => $country_tid
      ? ['target_id' => $country_tid]
      : [],

    'field_track_preference' => $track_tid
      ? ['target_id' => $track_tid]
      : [],

    'field_dietry_requirements' => $dietary_tid
      ? ['target_id' => $dietary_tid]
      : [],
  ]);

// ------------------------------------------------------------
// Generate Delegate Reference.
// Example: UP-2027-0001
// ------------------------------------------------------------

$institution_code = trim(
  $institution->get('field_institution_code')->value
);

if (empty($institution_code)) {
  \Drupal::logger('itsiug_registration')->error(
    'Institution @institution has no institution code.',
    [
      '@institution' => $institution->label(),
    ]
  );

  return;
}

// Find existing delegates for this institution.
$existing_delegate_nids = \Drupal::entityQuery('node')
  ->accessCheck(FALSE)
  ->condition('type', 'delegate')
  ->condition('field_institution', $institution->id())
  ->execute();

$next_number = 1;

foreach ($existing_delegate_nids as $existing_nid) {

  $existing_delegate = Node::load($existing_nid);

  if (!$existing_delegate) {
    continue;
  }

  if (!$existing_delegate->hasField('field_delegate_reference')) {
    continue;
  }

  $existing_reference = trim(
    $existing_delegate->get('field_delegate_reference')->value
  );

  if (preg_match(
    '/^' . preg_quote($institution_code, '/') . '-2027-(\d{4})$/',
    $existing_reference,
    $matches
  )) {
    $existing_number = (int) $matches[1];

    if ($existing_number >= $next_number) {
      $next_number = $existing_number + 1;
    }
  }
}

$delegate_reference = sprintf(
  '%s-2027-%04d',
  $institution_code,
  $next_number
);

// Set the Delegate Reference.
$delegate->set(
  'field_delegate_reference',
  $delegate_reference
);

// Confirm the value before saving.
\Drupal::logger('itsiug_registration')->notice(
  'Generated Delegate Reference: @reference',
  [
    '@reference' => $delegate_reference,
  ]
);

// Save the Delegate.
$delegate->save();

  // ------------------------------------------------------------
  // Load ITSIUG 2027 Conference.
  // ------------------------------------------------------------

  $conference = Node::load(2);

  if (!$conference || $conference->bundle() !== 'conference') {
    \Drupal::logger('itsiug_registration')->error(
      'ITSIUG 2027 conference node 2 could not be loaded.'
    );
    return;
  }

  // ------------------------------------------------------------
  // Create Conference Registration.
  // ------------------------------------------------------------

  $registration = Node::create([
  'type' => 'conference_registration',

  'title' => $delegate->label(),

  'status' => 1,

  'field_conference' => [
    'target_id' => $conference->id(),
  ],

  'field_delegate' => [
    'target_id' => $delegate->id(),
  ],

  'field_institution1' => [
    'target_id' => $institution->id(),
  ],

  'field_qr_code' => $delegate_reference,

  'field_registration_status' => 'pending',

  'field_checkin_status' => 'not_checked_in',

  'field_conference_gift' => 'not_received',

  'field_monday_attendance' => 'not_present',

  'field_tuesday_attendance' => 'not_present',

  'field_wednesday_attendance' => 'not_present',

  'field_certificate_eligibility' => 'not_eligible',

  'field_certificate_status' => 'not_generated',
]);

  $registration->save();

  // ------------------------------------------------------------
  // Log successful registration.
  // ------------------------------------------------------------

  \Drupal::logger('itsiug_registration')->notice(
    'Delegate @delegate registered for @conference through @institution. Reference: @reference',
    [
      '@delegate' => $delegate->label(),
      '@conference' => $conference->label(),
      '@institution' => $institution->label(),
      '@reference' => $delegate_reference,
    ]
  );
}


/**
 * Find a taxonomy term by name.
 *
 * @param mixed $value
 *   The Webform value.
 * @param string $vocabulary
 *   The taxonomy vocabulary machine name.
 *
 * @return int|null
 *   The taxonomy term ID, or NULL if not found.
 */
function itsiug_find_taxonomy_term($value, $vocabulary) {

  // Some Webform elements can return an array.
  if (is_array($value)) {
    $value = reset($value);
  }

  if (empty($value)) {
    return NULL;
  }

  $value = trim((string) $value);

  if ($value === '') {
    return NULL;
  }

  // These represent deliberate no-selection choices on forms.
  $no_selection_values = [
    'no preference',
    'none',
    'n/a',
    'na',
  ];

  if (in_array(strtolower($value), $no_selection_values, TRUE)) {
    return NULL;
  }

  $terms = \Drupal::entityTypeManager()
    ->getStorage('taxonomy_term')
    ->loadByProperties([
      'vid' => $vocabulary,
      'name' => $value,
    ]);

  if (empty($terms)) {
    $normalized_value = preg_replace('/[^a-z0-9]/', '', strtolower($value));

    $tree = \Drupal::entityTypeManager()
      ->getStorage('taxonomy_term')
      ->loadTree($vocabulary, 0, NULL, TRUE);

    foreach ($tree as $term) {
      $label = $term->label();
      $normalized_label = preg_replace('/[^a-z0-9]/', '', strtolower($label));

      if ($normalized_label === $normalized_value) {
        return $term->id();
      }
    }

    \Drupal::logger('itsiug_registration')->warning(
      'Taxonomy term "@value" was not found in vocabulary "@vocabulary".',
      [
        '@value' => $value,
        '@vocabulary' => $vocabulary,
      ]
    );

    return NULL;
  }

  $term = reset($terms);

  return $term->id();
}

/**
 * Map a webform value to a list field's stored key.
 *
 * @param mixed $value
 *   The submitted value from webform.
 * @param array<string, string> $allowed_values
 *   List field allowed values in key => label format.
 *
 * @return string
 *   The mapped list key, or an empty string when no match is found.
 */
function itsiug_map_list_field_value($value, array $allowed_values) {

  if (is_array($value)) {
    $value = reset($value);
  }

  $value = trim((string) $value);

  if ($value === '') {
    return '';
  }

  if (isset($allowed_values[$value])) {
    return $value;
  }

  foreach ($allowed_values as $key => $label) {
    if (strcasecmp($label, $value) === 0) {
      return $key;
    }
  }

  return '';
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * Determines certificate eligibility for conference registrations.
 *
 * A delegate is eligible for a certificate only when they have attended
 * all three conference days.
 */
function itsiug_registration_node_presave(\Drupal\node\NodeInterface $node) {

  // Keep Delegate title in sync with first and last name edits.
  if ($node->bundle() === 'delegate') {

    $first_name = '';
    $last_name = '';

    if ($node->hasField('field_first_name') && !$node->get('field_first_name')->isEmpty()) {
      $first_name = trim($node->get('field_first_name')->value);
    }

    if ($node->hasField('field_last_name') && !$node->get('field_last_name')->isEmpty()) {
      $last_name = trim($node->get('field_last_name')->value);
    }

    $title = trim($first_name . ' ' . $last_name);

    if ($title !== '') {
      $node->setTitle($title);
    }

    return;
  }

  // Only process Conference Registration nodes.
  if ($node->bundle() !== 'conference_registration') {
    return;
  }

  // A certificate requires attendance on all three conference days.
  $monday = $node->get('field_monday_attendance')->value;
  $tuesday = $node->get('field_tuesday_attendance')->value;
  $wednesday = $node->get('field_wednesday_attendance')->value;

  if (
    $monday === 'present' &&
    $tuesday === 'present' &&
    $wednesday === 'present'
  ) {
    $node->set(
      'field_certificate_eligibility',
      'eligible'
    );
  }
  else {
    $node->set(
      'field_certificate_eligibility',
      'not_eligible'
    );
  }
}

/**
 * Implements hook_node_update().
 *
 * Synchronises linked conference registrations when a delegate is edited.
 */
function itsiug_registration_node_update(NodeInterface $node) {

  if ($node->bundle() !== 'delegate') {
    return;
  }

  $registration_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'conference_registration')
    ->condition('field_delegate', $node->id())
    ->execute();

  if (empty($registration_ids)) {
    return;
  }

  $delegate_reference = '';

  if (
    $node->hasField('field_delegate_reference') &&
    !$node->get('field_delegate_reference')->isEmpty()
  ) {
    $delegate_reference = trim($node->get('field_delegate_reference')->value);
  }

  foreach ($registration_ids as $registration_id) {

    $registration = Node::load($registration_id);

    if (!$registration) {
      continue;
    }

    $changed = FALSE;

    if ($registration->getTitle() !== $node->label()) {
      $registration->setTitle($node->label());
      $changed = TRUE;
    }

    if (
      $delegate_reference !== '' &&
      $registration->hasField('field_qr_code')
    ) {
      $current_qr = (string) $registration->get('field_qr_code')->value;

      if ($current_qr !== $delegate_reference) {
        $registration->set('field_qr_code', $delegate_reference);
        $changed = TRUE;
      }
    }

    if ($changed) {
      $registration->save();
    }
  }
}

/**
 * Implements hook_entity_operation_alter().
 */
function itsiug_registration_entity_operation_alter(
  array &$operations,
  \Drupal\Core\Entity\EntityInterface $entity
) {

  if (
    $entity->getEntityTypeId() === 'node' &&
    $entity instanceof NodeInterface &&
    $entity->bundle() === 'delegate'
  ) {
    unset($operations['delete']);
  }
}

/**
 * Implements hook_user_login().
 */
function itsiug_registration_user_login(
  \Drupal\Core\Session\AccountInterface $account
) {

  $institution_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'institution')
    ->condition('field_representative', $account->id())
    ->range(0, 1)
    ->execute();

  if (empty($institution_ids)) {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  $current_destination = $request->query->get('destination');

  if (!empty($current_destination) && $current_destination !== '/user') {
    return;
  }

  \Drupal::service('redirect.destination')
    ->set('/register/dashboard');
}

/**
 * Implements hook_node_access().
 */
function itsiug_registration_node_access(
  NodeInterface $node,
  $operation,
  AccountInterface $account
) {

  if ($node->bundle() !== 'delegate') {
    return AccessResult::neutral();
  }

  if ($operation === 'delete') {

    $registration_ids = \Drupal::entityQuery('node')
      ->accessCheck(FALSE)
      ->condition('type', 'conference_registration')
      ->condition('field_delegate', $node->id())
      ->range(0, 1)
      ->execute();

    if (!empty($registration_ids)) {
      return AccessResult::forbidden()
        ->cachePerUser()
        ->addCacheableDependency($node);
    }

    return AccessResult::neutral()
      ->cachePerUser()
      ->addCacheableDependency($node);
  }

  if ($operation !== 'update') {
    return AccessResult::neutral();
  }

  if ($account->isAnonymous()) {
    return AccessResult::forbidden()->cachePerUser();
  }

  if ($node->hasField('field_institution') && !$node->get('field_institution')->isEmpty()) {
    $institution = $node->get('field_institution')->entity;

    if ($institution) {
      $institution_ids = \Drupal::entityQuery('node')
        ->accessCheck(FALSE)
        ->condition('type', 'institution')
        ->condition('field_representative', $account->id())
        ->condition('nid', $institution->id())
        ->range(0, 1)
        ->execute();

      if (!empty($institution_ids)) {
        return AccessResult::allowed()
          ->cachePerUser()
          ->addCacheableDependency($node);
      }
    }
  }

  return AccessResult::neutral()->cachePerUser()->addCacheableDependency($node);
}

/**
 * Implements hook_mail().
 */
function itsiug_registration_mail(
  $key,
  &$message,
  $params
) {

  if ($key !== 'certificate') {
    return;
  }

  $delegate = $params['delegate'] ?? '';
  $conference = $params['conference'] ?? 'ITSIUG 2027';
  $certificate_number = $params['certificate_number'] ?? '';
  $download_url = $params['download_url'] ?? '';

  $message['subject'] =
    'ITSIUG 2027 – Your Certificate of Attendance';

  $message['headers']['Content-Type'] =
    'text/html; charset=UTF-8';

  $message['body'][] = '
    <div style="
      font-family: Arial, Helvetica, sans-serif;
      max-width: 680px;
      margin: 0 auto;
      color: #333333;
      line-height: 1.6;
    ">

      <div style="
        background:#1f4b6b;
        padding:28px;
        text-align:center;
      ">
        <h1 style="
          color:#ffffff;
          margin:0;
          font-size:26px;
        ">
          ITSIUG 2027
        </h1>
      </div>

      <div style="padding:35px 30px;">

        <h2 style="
          color:#1f4b6b;
          margin-top:0;
        ">
          Certificate of Attendance
        </h2>

        <p>
          Dear ' . htmlspecialchars($delegate, ENT_QUOTES, 'UTF-8') . ',
        </p>

        <p>
          Congratulations!
        </p>

        <p>
          Thank you for attending and participating in
          <strong>' .
          htmlspecialchars($conference, ENT_QUOTES, 'UTF-8') .
          '</strong>.
        </p>

        <p>
          Your Certificate of Attendance has now been issued
          and is available for you to download.
        </p>

        <p style="text-align:center; margin:35px 0;">

          <a href="' .
          htmlspecialchars($download_url, ENT_QUOTES, 'UTF-8') .
          '"
             style="
               display:inline-block;
               background:#1f4b6b;
               color:#ffffff;
               text-decoration:none;
               padding:14px 28px;
               border-radius:4px;
               font-weight:bold;
               font-size:16px;
             ">
            DOWNLOAD YOUR CERTIFICATE
          </a>

        </p>

        <p>
          <strong>Certificate Reference:</strong><br>
          ' .
          htmlspecialchars($certificate_number, ENT_QUOTES, 'UTF-8') .
        '</p>

        <p>
          We thank you for being part of ITSIUG 2027
          and hope to welcome you again at a future conference.
        </p>

        <p>
          Kind regards,<br>
          <strong>ITSIUG 2027</strong>
        </p>

      </div>

      <div style="
        background:#f3f3f3;
        padding:18px 30px;
        text-align:center;
        font-size:12px;
        color:#666666;
      ">
        This is an automated message from the ITSIUG 2027
        conference registration system.
      </div>

    </div>
  ';
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function itsiug_registration_form_webform_submission_delegate_registration_add_form_alter(
  &$form,
  \Drupal\Core\Form\FormStateInterface $form_state,
  $form_id
) {
  $form['#attributes']['class'][] = 'itsiug-delegate-registration';

  // Add institution context heading above the registration form fields.
  $session = \Drupal::request()->getSession();
  $registration_context = $session->get('itsiug_registration');

  if (empty($registration_context['institution_nid'])) {
    return;
  }

  $institution = Node::load((int) $registration_context['institution_nid']);

  if (!$institution || $institution->bundle() !== 'institution') {
    return;
  }

  $institution_name = $institution->label();
  $membership_status = '';

  if ($institution->hasField('field_payment_status') && !$institution->get('field_payment_status')->isEmpty()) {
    $status_item = $institution->get('field_payment_status')->first();

    // Entity reference field: use referenced entity label.
    if (isset($status_item->entity) && $status_item->entity) {
      $membership_status = $status_item->entity->label();
    }
    // List/text field: try to resolve a human label from allowed values.
    elseif (isset($status_item->value) && $status_item->value !== '') {
      $status_value = $status_item->value;
      $membership_status = $status_value;

      $field_definition = $institution->getFieldDefinition('field_payment_status');
      $allowed_values = $field_definition->getSetting('allowed_values');

      if (is_array($allowed_values) && isset($allowed_values[$status_value])) {
        $membership_status = $allowed_values[$status_value];
      }
    }
  }

  if ($membership_status === '') {
    $membership_status = 'Not available';
  }

  $form['institution_membership_heading'] = [
    '#type' => 'markup',
    '#weight' => -1000,
    '#markup' => '<p><strong>Institution:</strong> ' . Html::escape($institution_name) . '</p>'
      . '<p><strong>Membership Status:</strong> ' . Html::escape($membership_status) . '</p>',
  ];
}

/**
 * Implements hook_form_BASE_FORM_ID_alter().
 */
function itsiug_registration_form_node_form_alter(
  &$form,
  \Drupal\Core\Form\FormStateInterface $form_state,
  $form_id
) {

  $node = $form_state->getFormObject()->getEntity();

  if ($node->bundle() !== 'delegate') {
    return;
  }

  if (isset($form['title'])) {
    $form['title']['#access'] = FALSE;
  }

  $form['#after_build'][] = 'itsiug_registration_delegate_form_after_build';
}

/**
 * After build callback for delegate node forms.
 */
function itsiug_registration_delegate_form_after_build(
  array $form,
  \Drupal\Core\Form\FormStateInterface $form_state
) {

  $node = $form_state->getFormObject()->getEntity();

  if ($node->bundle() !== 'delegate') {
    return $form;
  }

  if (isset($form['title'])) {
    $form['title']['#access'] = FALSE;
  }

  if (isset($form['field_title'])) {
    $form['field_title']['#weight'] = -1000;
  }

  return $form;
}

/**
 * Implements hook_preprocess_node().
 */
function itsiug_registration_preprocess_node(array &$variables) {

  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }

  if (empty($variables['node']) || !$variables['node'] instanceof NodeInterface) {
    return;
  }

  $node = $variables['node'];

  if ($node->bundle() !== 'delegate') {
    return;
  }

  $variables['content']['#attached']['library'][] = 'itsiug_theme/global-styling';

  $existing_prefix = $variables['content']['#prefix'] ?? '';
  $existing_suffix = $variables['content']['#suffix'] ?? '';

  $variables['content']['#prefix'] =
    $existing_prefix .
    '<div class="itsiug-reports-page itsiug-delegate-view-page">';

  $variables['content']['#suffix'] =
    '</div>' .
    $existing_suffix;

  if (isset($variables['content']['field_title'])) {
    $variables['content']['field_title']['#weight'] = -100;
  }

  if (isset($variables['content']['field_first_name'])) {
    $variables['content']['field_first_name']['#weight'] = -90;
  }

  $variables['content']['return_to_dashboard'] = [
    '#type' => 'link',
    '#title' => t('Return to Dashboard'),
    '#url' => \Drupal\Core\Url::fromRoute('itsiug_registration.dashboard'),
    '#attributes' => [
      'class' => [
        'button',
      ],
      'style' => 'display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;border:0;border-radius:5px;background:#1f4b6b;color:#ffffff !important;font-size:16px;font-weight:600;line-height:1.2;text-decoration:none !important;box-sizing:border-box;transition:background-color 0.2s ease,transform 0.1s ease,box-shadow 0.2s ease;',
    ],
    '#weight' => 1000,
  ];
}

/**
 * Implements hook_preprocess_page().
 *
 * Hide footer regions on specific registration info pages.
 */
function itsiug_registration_preprocess_page(array &$variables) {

  $route_name = \Drupal::routeMatch()->getRouteName();

  // Hide footer on /registerinfo.
  if ($route_name !== 'itsiug_registration.info') {
    return;
  }

  if (empty($variables['page']) || !is_array($variables['page'])) {
    return;
  }

  foreach (array_keys($variables['page']) as $region_name) {
    if (str_starts_with((string) $region_name, 'footer')) {
      unset($variables['page'][$region_name]);
    }
  }
}

/**
 * Implements hook_webform_access().
 *
 * Prevents the previous-submission notification from appearing
 * on the ITSIUG Delegate Registration form.
 */
function itsiug_registration_webform_access(
  \Drupal\Core\Entity\EntityInterface $entity,
  $operation,
  \Drupal\Core\Session\AccountInterface $account
) {

  if ($operation === 'submission_view_own') {

    $route_name = \Drupal::routeMatch()->getRouteName();

    if ($route_name === 'itsiug_registration.delegate') {
      return \Drupal\Core\Access\AccessResult::forbidden();
    }
  }

  return \Drupal\Core\Access\AccessResult::neutral();
}

/**
 * Implements hook_form_alter().
 */
function itsiug_registration_form_alter(
  &$form,
  \Drupal\Core\Form\FormStateInterface $form_state,
  $form_id
) {

  if ($form_id === 'webform_submission_delegate_registration_add_form') {
    $form['#attributes']['class'][] = 'itsiug-delegate-registration';

    $form['#validate'][] =
      'itsiug_registration_delegate_registration_validate';

    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#submit'][] =
        'itsiug_registration_delegate_registration_redirect_submit';
    }
  }

  if ($form_id === 'user_login_form') {
    $form['#validate'][] =
      'itsiug_registration_user_login_redirect_validate';
    $form['#submit'][] =
      'itsiug_registration_user_login_redirect_submit';
  }

}

/**
 * Validate duplicate delegate registrations by email per conference.
 */
function itsiug_registration_delegate_registration_validate(
  array &$form,
  \Drupal\Core\Form\FormStateInterface $form_state
) {

  $email = trim((string) $form_state->getValue('email'));

  if ($email === '') {
    return;
  }

  $email = mb_strtolower($email);

  // ITSIUG 2027 conference node.
  $conference_id = 2;

  $registration_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'conference_registration')
    ->condition('field_conference', $conference_id)
    ->execute();

  foreach ($registration_ids as $registration_id) {
    $registration = Node::load((int) $registration_id);

    if (!$registration || !$registration->hasField('field_delegate') || $registration->get('field_delegate')->isEmpty()) {
      continue;
    }

    $delegate = $registration->get('field_delegate')->entity;

    if (!$delegate || !$delegate->hasField('field_email') || $delegate->get('field_email')->isEmpty()) {
      continue;
    }

    $delegate_email = mb_strtolower(trim((string) $delegate->get('field_email')->value));

    if ($delegate_email !== $email) {
      continue;
    }

    $delegate_name = trim((string) $delegate->label());

    if ($delegate_name !== '') {
      $detail_line = 'This address is already registered as ' . htmlspecialchars($delegate_name, ENT_QUOTES, 'UTF-8') . '.';
    }
    else {
      $detail_line = 'This address is already registered.';
    }

    $message = \Drupal\Core\Render\Markup::create(
      '<div class="itsiug-duplicate-registration-message">'
      . '<strong>This email address is already registered for ITSIUG 2027.</strong><br>'
      . $detail_line . '<br>'
      . 'Please check the address or contact your institution representative for assistance.'
      . '</div>'
    );

    \Drupal::messenger()->addError($message);

    $form_state->setErrorByName(
      'email',
      t('This email address is already registered for ITSIUG 2027.')
    );

    \Drupal::logger('itsiug_registration')->notice(
      'Duplicate registration blocked for email @email.',
      ['@email' => $email]
    );

    return;
  }
}

/**
 * Redirect delegate registrations to custom confirmation page.
 */
function itsiug_registration_delegate_registration_redirect_submit(
  array &$form,
  \Drupal\Core\Form\FormStateInterface $form_state
) {
  $form_state->setRedirect('itsiug_registration.delegate_confirmation');
}

/**
 * Force destination for institution representative login.
 */
function itsiug_registration_user_login_redirect_validate(
  array &$form,
  \Drupal\Core\Form\FormStateInterface $form_state
) {

  $uid = $form_state->get('uid');

  if (empty($uid)) {
    return;
  }

  $institution_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'institution')
    ->condition('field_representative', (int) $uid)
    ->range(0, 1)
    ->execute();

  if (empty($institution_ids)) {
    return;
  }

  $request = \Drupal::requestStack()->getCurrentRequest();
  $request->request->set('destination', '/register/dashboard');
  $request->query->set('destination', '/register/dashboard');
}

/**
 * Ensure institution representative login lands on /register/dashboard.
 */
function itsiug_registration_user_login_redirect_submit(
  array &$form,
  \Drupal\Core\Form\FormStateInterface $form_state
) {

  $uid = $form_state->get('uid');

  if (empty($uid)) {
    return;
  }

  $institution_ids = \Drupal::entityQuery('node')
    ->accessCheck(FALSE)
    ->condition('type', 'institution')
    ->condition('field_representative', (int) $uid)
    ->range(0, 1)
    ->execute();

  if (!empty($institution_ids)) {
    $form_state->setRedirect('itsiug_registration.dashboard');
  }
}