<?php

/**
 * @file
 * Conference document library.
 */

declare(strict_types=1);

use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_HOOK() for views_view.
 */
function itsiug_documents_preprocess_views_view(array &$variables): void {
  if ($variables['view']->id() === 'documents') {
    $variables['#attached']['library'][] = 'itsiug_documents/documents';
  }
}

/**
 * Implements hook_preprocess_HOOK() for views_view_table.
 *
 * Adds the column heading to each cell so narrow screens can stack the table
 * into labelled cards.
 */
function itsiug_documents_preprocess_views_view_table(array &$variables): void {
  if ($variables['view']->id() !== 'documents') {
    return;
  }

  $renderer = \Drupal::service('renderer');
  $labels = [];
  foreach ($variables['header'] as $key => $column) {
    $content = $column['content'] ?? '';
    if (is_array($content)) {
      $content = $renderer->renderInIsolation($content);
    }
    $labels[$key] = trim(strip_tags((string) $content));
  }

  foreach ($variables['rows'] as $row_index => $row) {
    foreach ($row['columns'] as $key => $column) {
      if (empty($column['attributes'])) {
        continue;
      }
      if (!empty($labels[$key])) {
        $variables['rows'][$row_index]['columns'][$key]['attributes']->setAttribute('data-label', $labels[$key]);
      }
      // Views leaves whitespace in empty cells, so :empty cannot be used.
      $value = (string) $variables['view']->style_plugin->getField($row_index, $key);
      if (trim(strip_tags($value)) === '') {
        $variables['rows'][$row_index]['columns'][$key]['attributes']->addClass('itsiug-cell-empty');
      }
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for node.
 */
function itsiug_documents_preprocess_node(array &$variables): void {
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'document') {
    return;
  }

  $variables['content']['#attached']['library'][] = 'itsiug_documents/documents';
  $variables['content']['#prefix'] = ($variables['content']['#prefix'] ?? '')
    . '<div class="itsiug-reports-page itsiug-document-page">';
  $variables['content']['#suffix'] = '</div>' . ($variables['content']['#suffix'] ?? '');
}

/**
 * Implements hook_preprocess_HOOK() for field.
 *
 * The active theme has no base theme, so field markup carries no classes of its
 * own to hook styling onto.
 */
function itsiug_documents_preprocess_field(array &$variables): void {
  $element = $variables['element'] ?? [];
  if (($element['#entity_type'] ?? '') !== 'node' || ($element['#bundle'] ?? '') !== 'document') {
    return;
  }
  $variables['attributes']['class'][] = 'itsiug-field';
  $variables['title_attributes']['class'][] = 'itsiug-field__label';
}
